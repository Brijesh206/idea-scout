# Idea Scout — environment variables (Workflow A: HN + Reddit + PH -> scoring
# -> Sheets -> Telegram)
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never
# commit real keys. In GitHub Actions these same names are set as repo secrets.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Which provider scoring uses: nvidia | openrouter | anthropic
# Production runs on anthropic (Haiku) — calibration showed gpt-oss:free fails
# unreliably at the doc-03 batch size of 20 (see doc 03). Free providers are
# still wired for local testing / experimentation.
LLM_PROVIDER=anthropic

# NVIDIA Build API (free tier) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # override only if needed

# OpenRouter (free tier) — https://openrouter.ai
# The free lineup rotates; confirm a current ':free' model and put it here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1      # override only if needed

# Anthropic (production) — https://console.anthropic.com
# Set a spend cap under billing before using this (see doc 09).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Reddit ────────────────────────────────────────────────────────────────────
# No auth needed — public per-subreddit JSON feeds. Reddit blocks default/empty
# User-Agents, so set a descriptive one.
# REDDIT_SUBREDDITS=SaaS,microsaas,SideProject,EntrepreneurRideAlong,startups,SomebodyMakeThis,AppIdeas
# REDDIT_USER_AGENT=idea-scout/0.1 (personal project; contact via GitHub)
# REDDIT_POSTS_PER_SUBREDDIT=25

# ── Product Hunt ──────────────────────────────────────────────────────────────
# Free developer token — register at https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_API_TOKEN=
# PRODUCTHUNT_TOPICS=developer-tools,artificial-intelligence,saas,productivity,no-code
# PH_LOOKBACK_HOURS=24

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Sheet ID is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Service account credentials. Use ONE of the following:
#   - Local dev (easiest): path to the downloaded JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
#   - Or paste the raw JSON on one line (this is the form used as a CI secret)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tab name (defaults to "Idea Candidates" if unset)
# SHEET_TAB_CANDIDATES=Idea Candidates

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then find your chat_id via getUpdates (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Tunables (optional; sensible defaults in config.py) ───────────────────────
# DIGEST_THRESHOLD=70        # score >= this -> Telegram digest
# SHEET_THRESHOLD=40         # score >= this -> written to the Sheet
# SCORING_BATCH_SIZE=20      # candidates per LLM call
# DEDUPE_LOOKBACK_DAYS=14    # how far back to check for already-seen candidates
# HN_LOOKBACK_HOURS=24       # how recent an HN post must be to be ingested

# ── Not yet built ─────────────────────────────────────────────────────────────
# Engagement finder (doc 07) is a separate, later workflow — no env vars for it yet.
